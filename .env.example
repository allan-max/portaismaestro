# Gere um segredo próprio de pelo menos 32 caracteres e use o mesmo no gerenciador.
# Vazio mantém a identificação do robô bloqueada. Não versione o arquivo .env real.
ROBO_SECRET=

# Central de E-mails: mesmo valor do EMAILS_TOKEN do .env do serviço (pelo menos 32 caracteres).
# Vazio mantém o serviço de e-mails recusado.
EMAILS_TOKEN=
